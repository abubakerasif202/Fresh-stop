# Fresh Stop E-Commerce Environment Configuration Template
# Copy to .env.local (gitignored) and populate real values. Never commit real keys.

# ==============================================================================
# DATABASE (PostgreSQL / Supabase)
# ==============================================================================
# Connection pooling URL (port 6543 for Supabase transaction pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct non-pooling URL (port 5432) used for Prisma migrations and CLI tooling
DATABASE_URL_UNPOOLED="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Optional Vercel Supabase integration aliases (Next.js automatically binds if present)
# POSTGRES_PRISMA_URL=""
# POSTGRES_URL_NON_POOLING=""

# Allow running local development seed scripts (keep 0 in production)
ALLOW_DEVELOPMENT_SEED="0"

# Catalogue data mode: "database" (production default) or "reviewed-snapshot" (offline development)
CATALOGUE_DATA_SOURCE="database"

# ==============================================================================
# STRIPE PAYMENTS (AUD)
# ==============================================================================
# Stripe Secret Key (server-side only)
# Test mode keys start with sk_test_... | Live keys start with sk_live_...
STRIPE_SECRET_KEY="sk_test_..."

# Stripe Webhook Signing Secret (retrieved from Stripe Dashboard -> Developers -> Webhooks)
# Used to cryptographically verify incoming stripe events at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Publishable Key (client-safe)
# Test mode keys start with pk_test_... | Live keys start with pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Fresh Stop sandbox account the webhook must belong to (events from other accounts are refused)
STRIPE_EXPECTED_ACCOUNT="acct_1USJ2G7k4A7HyNzJ"

# Two-key paid-checkout gate. BOTH must be on (this flag AND the admin Settings approval).
# Leave "false" until pricing, stock and delivery rules are business-approved.
PAID_CHECKOUT_ENABLED="false"

# NEVER set to "true" during sandbox work. Only a deliberate, approved go-live change.
# STRIPE_ALLOW_LIVE=""

# ==============================================================================
# NOTIFICATIONS & TRANSACTIONAL EMAIL (Resend)
# ==============================================================================
# Resend API Key for sending order confirmations to customers and store alerts
# If unset, no email is sent and the order records that sending was not configured
RESEND_API_KEY="re_..."

# Verified sending email domain (configured in Resend dashboard)
RESEND_FROM_EMAIL="Fresh Stop Orders <orders@freshstop.com.au>"

# Merchant recipient email for incoming paid order notifications
ORDERS_NOTIFICATION_EMAIL="info@freshstop.com.au"

# Dedicated random server-only signing secret (at least 32 bytes) for expiring order links.
ORDER_ACCESS_SECRET=""

# Bearer secret for the approved external expiry/email-retry scheduler.
CRON_SECRET=""

# ==============================================================================
# ADMIN SECURITY & AUTHENTICATION
# ==============================================================================
# Admin username for HTTP Basic Auth (/admin and /api/admin/*)
ADMIN_USER="admin"

# Strong admin password (minimum 16 random characters recommended)
ADMIN_PASSWORD=""


# ==============================================================================
# RATE LIMITING & SECURITY (Upstash Redis)
# ==============================================================================
# Required in production to enforce rate limiting on admin login and checkout endpoints
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==============================================================================
# APPLICATION & SITE URL
# ==============================================================================
# Base URL for canonical links, OpenGraph, and Stripe Checkout redirect return URLs
NEXT_PUBLIC_SITE_URL="https://fresh-stop.vercel.app"
