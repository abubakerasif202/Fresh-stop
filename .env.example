# Copy to .env (gitignored) and set real values. Never commit secrets.

# PostgreSQL. On Vercel with the Neon integration both are injected automatically.
# Locally, point both at the same database (e.g. postgresql://user:pass@localhost:5432/freshstop).
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Seed only a disposable local PostgreSQL database. Remote hosts, production and
# Vercel are always refused. Set to 1 only when intentionally running db:seed.
ALLOW_DEVELOPMENT_SEED="0"

# Admin portal (/admin and /api/admin/*) is protected with HTTP Basic Auth.
# If ADMIN_PASSWORD is unset or empty, admin routes return 503 (fail closed).
# Repeated failed logins from one IP are locked out (429) for 15 minutes.
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me-to-a-long-random-string"

# Secret used to sign order-confirmation links (HMAC). Min 16 chars.
# Generate with: openssl rand -base64 32
# REQUIRED for checkout and lookup: missing/short secrets return 503 before
# order creation. Keep stable: rotation invalidates existing confirmation links
# and checkout idempotency identifiers.
ORDER_TOKEN_SECRET=""

# Shared rate limits for checkout, order lookup and admin authentication.
# Required in production and all Vercel environments. Missing configuration or
# Redis outages return 503; only local development falls back to process memory.
# Use an HTTPS Upstash Redis REST endpoint and a server-only read/write token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Public site URL, used for metadataBase (absolute OG/canonical URLs).
# Falls back to https://fresh-stop.vercel.app when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
