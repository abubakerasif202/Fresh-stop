# Copy to .env (gitignored) and set real values. Never commit secrets.

# PostgreSQL: explicitly configure these application variables in hosting.
# Integration aliases such as POSTGRES_PRISMA_URL are not automatic substitutes.
# Supabase shared pooler session URLs on port 5432 are switched to transaction
# pooling on port 6543 at runtime. Keep DATABASE_URL_UNPOOLED direct for Prisma CLI.
# Locally, point both at the same database (e.g. postgresql://user:pass@localhost:5432/freshstop).
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Seed only a disposable local PostgreSQL database. Remote hosts, production and
# Vercel are always refused. Set to 1 only when intentionally running db:seed.
ALLOW_DEVELOPMENT_SEED="0"

# Admin portal (/admin and /api/admin/*) is protected with HTTP Basic Auth.
# If ADMIN_PASSWORD is unset or empty, admin routes return 503 (fail closed).
# Repeated failed logins from one IP are locked out (429) for 15 minutes.
ADMIN_USER="admin"
# Leave disabled until a long random password is supplied privately.
ADMIN_PASSWORD=""

# Legacy order-confirmation secret retained only for historical compatibility.
# Public checkout/order lookup are retired (HTTP 410); not needed by enquiries.
# Keep private if retained. Do not revive purchasing without a separate review.
ORDER_TOKEN_SECRET=""

# Shared rate limits for admin authentication. Public purchase APIs are retired.
# Required in production and all Vercel environments. Missing configuration or
# Redis outages return 503; only local development falls back to process memory.
# Use an HTTPS Upstash Redis REST endpoint and a server-only read/write token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Public site URL, used for metadataBase (absolute OG/canonical URLs).
# Falls back to https://fresh-stop.vercel.app when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# database (default) or explicit reviewed-snapshot for local/Preview only.
# Snapshot contains staged proposals; writes and historical orders are blocked.
# Vercel Production refuses reviewed-snapshot.
CATALOGUE_DATA_SOURCE="database"
