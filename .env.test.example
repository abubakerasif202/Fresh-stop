# Copy to .env.test (git-ignored) for local test runs. NO real secrets belong in this file.
# Disposable local Postgres: `npm run db:local -- start` (data in ~/fresh-stop-pgdata, port 54329).
DATABASE_URL=postgresql://fs_dev:fs_dev@localhost:54329/fresh_stop_dev
DATABASE_URL_UNPOOLED=postgresql://fs_dev:fs_dev@localhost:54329/fresh_stop_dev

# Paid checkout stays OFF unless BOTH keys are on: this env flag AND DeliverySetting
# paidCheckoutApproved="true" in the database. Never enable against a shared database.
PAID_CHECKOUT_ENABLED=false

# Stripe TEST mode only (sk_test_/rk_test_). Leave blank in tests: use mocks/fixtures.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: expected Stripe account id for webhook verification (test account only).
STRIPE_EXPECTED_ACCOUNT=
STRIPE_ALLOW_LIVE=false

# Scripts refuse non-local databases unless a human sets these in the shell (never commit them):
# ALLOW_REMOTE_DB_READ=yes-i-approved
# ALLOW_REMOTE_DB_WRITE=yes-i-approved
