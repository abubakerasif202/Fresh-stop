datasource db {
  provider = "sqlite"
  url      = "file:./fresh-stop.db"
}

generator client {
  provider = "prisma-client-js"
}

model StoreBranch {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  address        String
  suburb         String
  state          String            @default("NSW")
  postcode       String
  phone          String
  email          String
  googleMapsUrl  String
  openingHours   String
  isActive       Boolean           @default(true)
  orders         Order[]
  inventory      BranchInventory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  imageUrl     String?
  displayOrder Int       @default(0)
  products     Product[]
}

model Product {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  price          Float
  unit           String            @default("kg")
  compareAtPrice Float?
  isSpecial      Boolean           @default(false)
  specialPrice   Float?
  imageUrl       String
  categoryId     String
  category       Category          @relation(fields: [categoryId], references: [id])
  inventory      BranchInventory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([categoryId])
}

model BranchInventory {
  id            String      @id @default(cuid())
  storeBranchId String
  productId     String
  isAvailable   Boolean     @default(true)
  storeBranch   StoreBranch @relation(fields: [storeBranchId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeBranchId, productId])
}

model DeliveryZone {
  id                   String   @id @default(cuid())
  name                 String
  postcodes            String
  deliveryFee          Float
  freeDeliveryMinSpend Float    @default(150.0)
  minOrderAmount       Float    @default(50.0)
  primaryBranchSlug    String
  isActive             Boolean  @default(true)
}

model Order {
  id                String       @id @default(cuid())
  orderNumber       String       @unique
  fulfillmentType   String
  storeBranchId     String
  storeBranch       StoreBranch  @relation(fields: [storeBranchId], references: [id])
  customerName      String
  customerEmail     String
  customerPhone     String
  deliveryAddress   String?
  deliveryPostcode  String?
  deliveryNotes     String?
  pickupTimeslot    String?
  itemsJson         String
  subtotal          Float
  deliveryFee       Float        @default(0.0)
  total             Float
  paymentMethod     String
  paymentStatus     String
  orderStatus       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([storeBranchId])
  @@index([orderStatus])
  @@index([createdAt])
}
